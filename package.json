{
  "name": "ggn-layout",
  "version": "0.1.0",
  "description": "ELK Layered 1:1 TypeScript 移植 (模型/算法/变量名与 ELK 源码一致)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.js"
      },
      "require": {
        "types": "./dist/api/index.d.cts",
        "default": "./dist/api/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./options": {
      "import": {
        "types": "./dist/options.d.ts",
        "default": "./dist/options.js"
      },
      "require": {
        "types": "./dist/options.d.cts",
        "default": "./dist/options.cjs"
      }
    },
    "./layered": {
      "import": {
        "types": "./dist/api/layered.d.ts",
        "default": "./dist/api/layered.js"
      },
      "require": {
        "types": "./dist/api/layered.d.cts",
        "default": "./dist/api/layered.cjs"
      }
    },
    "./layout-worker": {
      "import": {
        "types": "./dist/layout-worker.d.ts",
        "default": "./dist/layout-worker.js"
      },
      "require": {
        "types": "./dist/layout-worker.d.cts",
        "default": "./dist/layout-worker.cjs"
      }
    },
    "./layout-input.schema.json": "./src/api/layout-input.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "files": [
    "dist",
    "docs/API.md",
    "docs/API-QUICKREF.md",
    "docs/reference",
    "examples",
    "llms.txt",
    "THIRD_PARTY_NOTICES.md",
    "src/api/layout-input.schema.json",
    "CHANGELOG.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/check-process-env-defines.mjs && tsdown",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "prepublishOnly": "npm run typecheck && npm run test:ci && npm run build && npm run smoke:pack && npm run check:pkg",
    "check:pkg": "npx --yes publint@0.3.25 && node scripts/check-attw.mjs",
    "check:attw": "node scripts/check-attw.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc -p tsconfig.build.json --noEmit",
    "check:defines": "node scripts/check-process-env-defines.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite demo-vite",
    "demo:data": "bun scripts/build-demo-data.mjs",
    "demo:host": "vite demo-vite --host",
    "mutation": "stryker run",
    "mutation:report": "stryker run --reporters html",
    "verify:696": "node scripts/diff-failures.mjs collect-all && node scripts/diff-failures.mjs check /tmp/failures-696.json",
    "verify:json-path": "bun scripts/verify-json-path.mjs",
    "verify:elkg-elkt": "bun scripts/verify-elkg-elkt.mjs",
    "verify:elkt-java": "bun scripts/verify-elkt-java.mjs",
    "verify:elkg-java-layout": "bun scripts/verify-elkg-java-layout.ts",
    "verify:demo-data": "bun scripts/verify-demo-data.mjs",
    "check:failures": "node scripts/diff-failures.mjs check /tmp/failures-696.json",
    "generate:oracle": "node scripts/generate-jar-oracle.mjs",
    "test:bdd": "vitest run tests/bdd",
    "test:gherkin": "vitest run tests/bdd",
    "test:edge-e2e": "vitest run tests/oracle/EdgeRoutingE2ETest.test.ts",
    "test:oracle-p3": "vitest run tests/oracle/generated/json_path_batch.test.ts",
    "scan:edge-e2e": "bun scripts/scan-edge-e2e.mjs --write",
    "stage-diff": "bun scripts/stage-diff.mjs",
    "stage-diff:diff": "bun scripts/stage-diff.mjs diff",
    "verify:public-api": "bun scripts/verify-public-api.mjs",
    "verify:bit-exact": "bun scripts/verify-bit-exact.mjs",
    "check:bench": "bun scripts/bench-gate.mjs",
    "check:bench:nonlayered": "bun scripts/perf-nonlayered.mjs --quick --json bench-results/current-nonlayered.json && bun scripts/check-bench-regression.mjs --baseline bench-results/baseline-nonlayered.json --current bench-results/current-nonlayered.json --min-delta-ms 40",
    "test:run": "vitest run",
    "test:ci": "vitest run --exclude 'tests/oracle/generated/**'",
    "test:cross-engine": "bun ./node_modules/vitest/vitest.mjs run --config vitest.cross-engine.config.ts",
    "check:bundle": "bunx tsdown && node scripts/check-bundle-budget.mjs"
  },
  "keywords": [
    "graph-layout",
    "graph",
    "layout",
    "elk",
    "layered",
    "sugiyama",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xlxx/ggn-layout.git"
  },
  "homepage": "https://github.com/0xlxx/ggn-layout#readme",
  "bugs": {
    "url": "https://github.com/0xlxx/ggn-layout/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "20",
    "@vitest/ui": "^4.1.10",
    "cac": "^7.0.0",
    "elkjs": "^0.12.0",
    "glob": "^13.0.6",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  }
}
