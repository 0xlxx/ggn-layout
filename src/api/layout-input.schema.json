{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "运行时契约以 validateLayoutInput 为准，本 schema 供工具/agent 消费",
  "title": "LayoutInput",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "width": {
      "type": "number",
      "minimum": 0
    },
    "height": {
      "type": "number",
      "minimum": 0
    },
    "layoutOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/port"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/label"
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/edge"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "layoutOptions": {
          "type": "object",
          "additionalProperties": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "label": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "sources",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "layoutOptions": {
          "type": "object",
          "additionalProperties": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/label"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
