graph root
node group {
	algorithm: org.eclipse.elk.sporeOverlap
	layout [ size: 300, 200 ]
	org.eclipse.elk.overlapRemoval.runScanline: false
	org.eclipse.elk.overlapRemoval.maxIterations: 2
	node g1 {
		layout [ size: 60, 40 ]
		^position: "(10, 10)"
	}
	node g2 {
		layout [ size: 80, 60 ]
		^position: "(40, 30)"
	}
	node g3 {
		layout [ size: 50, 50 ]
		^position: "(70, 60)"
	}
}
node a {
	layout [ size: 40, 30 ]
}
edge a -> group
